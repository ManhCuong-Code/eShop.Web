@using eShop.CoreBusiness.Models
@inject IViewOutstandingOrdersUseCase ViewOutstandingOrdersUseCase
@inject IProcessOrderUseCase ProcessOrderUseCase
@inject AuthenticationStateProvider AuthStateProvider

<div class="card shadow-sm border-0 my-3">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Danh Sách Đơn Hàng Chờ Xử Lý (Outstanding Orders)</h5>
        <button class="btn btn-sm btn-outline-dark" @onclick="LoadOrders"><i class="bi bi-arrow-clockwise me-1"></i>Làm mới</button>
    </div>
    <div class="card-body">
        @if (selectedOrderId > 0)
        {
            <OrderDetailComponent OrderId="@selectedOrderId" OnClose="HandleDetailClose" />
        }

        @if (orders != null && orders.Any())
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Ngày Đặt</th>
                        <th>Tên Khách Hàng</th>
                        <th>Địa Chỉ Giao Hàng</th>
                        <th class="text-center">Số Mặt Hàng</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ord in orders)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@ord.OrderID</td>
                            <td>@ord.DatePlaced?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@ord.CustomerName</td>
                            <td>@ord.CustomerCity, @ord.CustomerCountry</td>
                            <td class="text-center">@ord.LineItemCount</td>
                            <td class="text-end fw-bold text-danger">@ord.TotalPrice.ToString("C")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-info text-white me-2" @onclick="() => ViewDetails(ord.OrderID ?? 0)">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                                <button class="btn btn-sm btn-success" @onclick="() => ProcessOrder(ord.OrderID ?? 0)">
                                    <i class="bi bi-check-circle"></i> Duyệt Đơn
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-success mb-0">
                <i class="bi bi-check-all me-2"></i>Tuyệt vời! Hiện tại không có đơn hàng nào đang chờ xử lý.
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<Order>? orders;
    private int selectedOrderId = 0;

    protected override void OnInitialized()
    {
        LoadOrders();
    }

    private void LoadOrders()
    {
        orders = ViewOutstandingOrdersUseCase.Execute();
    }

    private void ViewDetails(int orderId)
    {
        selectedOrderId = orderId;
    }

    private void HandleDetailClose()
    {
        selectedOrderId = 0;
    }

    private async Task ProcessOrder(int orderId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        string adminName = authState.User.Identity?.Name ?? "admin";

        bool ok = ProcessOrderUseCase.Execute(orderId, adminName);
        if (ok)
        {
            selectedOrderId = 0;
            LoadOrders();
        }
    }
}