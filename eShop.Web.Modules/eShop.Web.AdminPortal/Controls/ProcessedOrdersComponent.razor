@using eShop.CoreBusiness.Models
@inject IViewProcessedOrdersUseCase ViewProcessedOrdersUseCase

<div class="card shadow-sm border-0 my-3">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-check2-all me-2"></i>Lịch Sử Đơn Hàng Đã Xử Lý (Processed Orders)</h5>
        <button class="btn btn-sm btn-light" @onclick="LoadOrders"><i class="bi bi-arrow-clockwise me-1"></i>Làm mới</button>
    </div>
    <div class="card-body">
        @if (selectedOrderId > 0)
        {
            <OrderDetailComponent OrderId="@selectedOrderId" OnClose="HandleDetailClose" />
        }

        @if (orders != null && orders.Any())
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Ngày Đặt</th>
                        <th>Ngày Xử Lý</th>
                        <th>Người Xử Lý</th>
                        <th>Tên Khách Hàng</th>
                        <th class="text-center">Số Mặt Hàng</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ord in orders)
                    {
                        <tr>
                            <td class="fw-bold text-success">#@ord.OrderID</td>
                            <td>@ord.DatePlaced?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@ord.DateProcessed?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge bg-secondary">@ord.AdminUser</span></td>
                            <td>@ord.CustomerName</td>
                            <td class="text-center">@ord.LineItemCount</td>
                            <td class="text-end fw-bold text-danger">@ord.TotalPrice.ToString("C")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetails(ord.OrderID ?? 0)">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info mb-0">
                Chưa có đơn hàng nào được đánh dấu là đã xử lý.
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<Order>? orders;
    private int selectedOrderId = 0;

    protected override void OnInitialized()
    {
        LoadOrders();
    }

    private void LoadOrders()
    {
        orders = ViewProcessedOrdersUseCase.Execute();
    }

    private void ViewDetails(int orderId)
    {
        selectedOrderId = orderId;
    }

    private void HandleDetailClose()
    {
        selectedOrderId = 0;
    }
}