@page "/products/{id:int}"
@page "/product/{id:int}"
@rendermode InteractiveServer

@inject NavigationManager navigationManager

@inject IViewProductUseCase viewProduct
@inject IAddProductToCartUseCase addProductToCartUseCase

<PageTitle>@(product != null ? product.Name : "Chi Tiết Sản Phẩm") - eShop</PageTitle>

<div class="container my-4">
    <div class="mb-4">
        <NavLink href="/products" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách sản phẩm
        </NavLink>
    </div>

    @if (product != null)
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
            <div class="row g-0">
                <div class="col-md-5 d-flex align-items-center justify-content-center bg-light-subtle p-5 border-end border-light">
                    <img src="@product.ImageLink" alt="@product.Name" class="img-fluid" style="max-height: 380px; object-fit: contain;" />
                </div>
                <div class="col-md-7 d-flex flex-column">
                    <div class="card-body p-4 p-md-5 d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill text-uppercase fw-semibold">
                                @product.Brand
                            </span>
                            <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill">
                                Mã SP: #@product.productId
                            </span>
                        </div>
                        <h2 class="card-title fw-bold mb-3 text-dark">@product.Name</h2>
                        <div class="mb-4">
                            <span class="fs-2 fw-bolder text-danger">@product.Price.ToString("C")</span>
                            <span class="text-success small ms-2"><i class="bi bi-check-circle me-1"></i>Còn hàng</span>
                        </div>

                        <hr class="border-light-subtle my-3" />

                        <div class="mb-4">
                            <h6 class="text-secondary fw-semibold text-uppercase small mb-2">Mô tả sản phẩm</h6>
                            <p class="card-text text-muted" style="line-height: 1.7;">@product.Description</p>
                        </div>

                        <div class="mt-auto pt-3">
                            <button class="btn btn-primary btn-lg px-5 py-3 fw-bold rounded-pill shadow-sm d-inline-flex align-items-center gap-2" @onclick="AddToCart">
                                <i class="bi bi-cart-plus-fill fs-5"></i>
                                <span>Thêm Vào Giỏ Hàng</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm rounded-4 p-4 text-center my-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 d-block mb-2"></i>
            <div>Không tìm thấy thông tin sản phẩm hoặc sản phẩm không tồn tại.</div>
            <a href="/products" class="btn btn-outline-primary btn-sm mt-3 rounded-pill px-4">Quay lại danh mục</a>
        </div>
    }
</div>

@code {
    private Product? product;

    [Parameter]
    public int Id { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Id > 0)
        {
            product = viewProduct.Execute(Id);
        }
    }
    private void AddToCart()
    {
        if (product != null)
        {
            addProductToCartUseCase.Execute(product.productId);
            navigationManager.NavigateTo("/");
        }
    }
}
