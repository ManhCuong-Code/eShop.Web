@page "/placeorder"
@rendermode InteractiveServer

@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IPlaceOrderUseCase placeOrderUseCase
@inject NavigationManager navigationManager

<PageTitle>Thanh Toán Đơn Hàng - eShop</PageTitle>

<div class="container my-4">
    <!-- Stepper Navigation -->
    <div class="checkout-steps mb-4">
        <a href="/cart" class="step-item completed text-decoration-none">
            <span class="step-num"><i class="bi bi-check-lg"></i></span>
            <span>1. Giỏ hàng</span>
        </a>
        <div class="step-divider"></div>
        <div class="step-item active">
            <span class="step-num">2</span>
            <span>2. Thông tin giao hàng</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item">
            <span class="step-num">3</span>
            <span>3. Hoàn tất</span>
        </div>
    </div>

    @if (order != null)
    {
        <div class="row g-4">
            <!-- Left Column: Shipping / Customer Details -->
            <div class="col-lg-7">
                <div class="card p-4 shadow-sm border-0 rounded-4 bg-white">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-geo-alt-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Thông Tin Người Nhận & Giao Hàng</h5>
                            <small class="text-muted">Vui lòng điền thông tin để chúng tôi chuyển hàng đến bạn</small>
                        </div>
                    </div>

                    @if (isError)
                    {
                        <div class="alert alert-danger d-flex align-items-center border-0 shadow-sm rounded-3 mb-4">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0"></i>
                            <div>Vui lòng điền đầy đủ <strong>Họ tên</strong> và <strong>Địa chỉ giao hàng</strong>!</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">
                            Họ và tên người nhận <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" @bind="order.CustomerName" placeholder="Nguyen Van A" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">
                            Địa chỉ giao hàng <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-house-door"></i></span>
                            <input type="text" class="form-control" @bind="order.CustomerAddress" placeholder="123 Duong Le Loi" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Tỉnh / Thành phố</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input type="text" class="form-control" @bind="order.CustomerCity" placeholder="Da Nang" />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Quận / Huyện / Bang</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-signpost-2"></i></span>
                                <input type="text" class="form-control" @bind="order.CustomerStateProvince" placeholder="Hai Chau" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Quốc gia</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-globe-americas"></i></span>
                            <input type="text" class="form-control" @bind="order.CustomerCountry" placeholder="Vietnam" />
                        </div>
                    </div>

                    <div class="p-3 border rounded-3 bg-light mb-4 d-flex align-items-center gap-3">
                        <i class="bi bi-cash-stack text-success fs-4"></i>
                        <div>
                            <div class="fw-bold text-dark">Thanh toán khi nhận hàng (COD)</div>
                            <small class="text-muted">Kiểm tra hàng và thanh toán tiền mặt trực tiếp cho shipper</small>
                        </div>
                    </div>

                    <button class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" 
                            @onclick="HandlePlaceOrder">
                        <i class="bi bi-check2-circle fs-5"></i>
                        <span>Xác Nhận & Đặt Hàng</span>
                    </button>
                    
                    <div class="text-center mt-3">
                        <a href="/cart" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary -->
            <div class="col-lg-5">
                <div class="position-sticky" style="top: 1.5rem;">
                    <OrderSummaryComponent Order="order" HidePlaceOrderButton="true"></OrderSummaryComponent>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 my-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted fw-semibold">Đang chuẩn bị thông tin đơn hàng...</p>
        </div>
    }
</div>

@code {
    private Order? order;
    private bool isError = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            order = await viewShoppingCartUseCase.Execute();
            StateHasChanged();
        }
    }

    private async Task HandlePlaceOrder()
    {
        if (order == null || string.IsNullOrWhiteSpace(order.CustomerName) || string.IsNullOrWhiteSpace(order.CustomerAddress))
        {
            isError = true;
            return;
        }

        isError = false;
        string? orderUniqueId = await placeOrderUseCase.Execute(order);
        if (!string.IsNullOrEmpty(orderUniqueId))
        {
            navigationManager.NavigateTo($"/orderconfirm/{orderUniqueId}");
        }
    }
}
