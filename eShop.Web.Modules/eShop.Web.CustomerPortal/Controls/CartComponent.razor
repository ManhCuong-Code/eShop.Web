@rendermode InteractiveServer
@implements IDisposable
@inject IShoppingCartStateStore shoppingCartStateStore

<div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white bg-opacity-10 border border-white border-opacity-25 rounded-pill text-white shadow-sm" style="transition: all 0.2s ease;">
    <i class="bi bi-cart3 fs-5"></i>
    <span class="d-none d-sm-inline fw-semibold small">Giỏ Hàng</span>
    <span class="badge bg-danger rounded-pill px-2 py-1">@lineItemCount</span>
</div>

@code {
    private int lineItemCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            shoppingCartStateStore.AddStateChangeListeners(HandleShoppingCartStateChange);
            lineItemCount = await shoppingCartStateStore.GetItemsCount();
            StateHasChanged();
        }
    }

    private async void HandleShoppingCartStateChange()
    {
        lineItemCount = await shoppingCartStateStore.GetItemsCount();
        StateHasChanged();
    }

    public void Dispose()
    {
        shoppingCartStateStore.RemoveStateChangeListeners(HandleShoppingCartStateChange);
    }
}
