<div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card m-2" style="width: 15rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
    <div class="position-relative bg-white text-center p-3 d-flex align-items-center justify-content-center" style="height: 190px;">
        @if (!string.IsNullOrEmpty(product?.Brand))
        {
            <span class="position-absolute top-0 start-0 m-2 badge bg-light text-secondary border small">@product.Brand</span>
        }
        <img src="@product?.ImageLink" class="img-fluid" alt="@product?.Name" style="max-height: 160px; object-fit: contain;" />
    </div>
    <div class="card-body d-flex flex-column p-3 bg-white border-top">
        <h6 class="card-title text-truncate fw-semibold mb-2" title="@product?.Name">
            <NavLink href=@($"/product/{product?.ProductId}") class="text-dark text-decoration-none">
                @product?.Name
            </NavLink>
        </h6>
        <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
            <span class="fw-bold text-danger fs-5">
                @product?.Price.ToString("c")
            </span>
            <NavLink href=@($"/product/{product?.ProductId}") class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1">
                Xem
            </NavLink>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product? product { get; set; }
}
