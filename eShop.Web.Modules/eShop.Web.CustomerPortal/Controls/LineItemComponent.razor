@using eShop.UseCases.ShoppingCartScreen.Interfaces

@inject IDeleteProductUseCase deleteProductUseCase
@inject IUpdateQuantityUseCase updateQuantityUseCase

@if (LineItem != null && LineItem.Product != null)
{
    <li class="card mb-3 border-0 shadow-sm rounded-4 p-3 bg-white">
        <div class="row align-items-center g-3">
            <div class="col-3 col-sm-2 text-center">
                <img src="@LineItem.Product.ImageLink" alt="@LineItem.Product.Name" 
                     style="height: 75px; width: 75px; object-fit: contain; border-radius: 10px; background: #fff;" class="border p-1" />
            </div>
            <div class="col-6 col-sm-7">
                <h6 class="fw-bold text-dark mb-1">@LineItem.Product.Name</h6>
                <div class="text-primary fw-semibold mb-2">@LineItem.Product.Price.ToString("c")</div>
                <div class="d-inline-flex align-items-center gap-2">
                    <span class="text-muted small">Số lượng:</span>
                    <input type="number" min="1" class="form-control form-control-sm text-center fw-bold" 
                           style="width: 70px; border-radius: 8px;" value="@LineItem.Quantity" @onchange="HandleQuantityChange" />
                </div>
            </div>
            <div class="col-3 col-sm-3 text-end">
                <div class="fw-bold text-dark mb-2 d-none d-sm-block">
                    @((LineItem.Price * LineItem.Quantity).ToString("c"))
                </div>
                <button class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1" @onclick="@(() => DeleteProduct(LineItem.ProductId))" title="Xoá sản phẩm">
                    <i class="bi bi-trash3 me-1"></i><span class="d-none d-md-inline">Xoá</span>
                </button>
            </div>
        </div>
    </li>
}

@code {
    [Parameter]
    public OrderLineItem? LineItem { get; set; }

    [Parameter]
    public EventCallback<Order> OnDeleteProduct { get; set; }

    [Parameter]
    public EventCallback<Order> OnUpdateQuantity { get; set; }

    async Task HandleQuantityChange(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrWhiteSpace(e.Value.ToString())) return;

        if (int.TryParse(e.Value.ToString(), out int qty))
        {
            if (qty < 0) return;
            var order = await updateQuantityUseCase.Execute(LineItem!.ProductId, qty);
            await OnUpdateQuantity.InvokeAsync(order);
        }
    }

    async Task DeleteProduct(int productId)
    {
        var order = await deleteProductUseCase.Execute(productId);
        await OnDeleteProduct.InvokeAsync(order);
    }
}
