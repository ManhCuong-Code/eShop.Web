@inherits LayoutComponentBase
<PageTitle>eShop.Web</PageTitle>
<main class="d-flex flex-column min-vh-100">
    <TopNavbar></TopNavbar>

    <article class="content px-3 px-md-4 py-4 flex-grow-1">
        @Body
    </article>

    <footer class="bg-white border-top py-4 mt-auto text-center text-muted small">
        <div class="container">
            <p class="mb-1 fw-semibold text-dark">eShop - Hệ Thống Bán Lẻ & Mua Sắm Trực Tuyến</p>
            <p class="mb-0 text-secondary">&copy; @DateTime.Now.Year eShop. Tất cả quyền được bảo lưu.</p>
        </div>
    </footer>
</main>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
